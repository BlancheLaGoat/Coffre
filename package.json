{
  "name": "coffre",
  "productName": "Coffre",
  "version": "1.15.0",
  "description": "Coffre : collection de cartes (Forbidden Memories, Yu-Gi-Oh, One Piece) et de vinyles",
  "author": "BlancheLaGoat",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.blanchelagoat.coffre",
    "productName": "Coffre",
    "copyright": "BlancheLaGoat",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Coffre"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BlancheLaGoat",
        "repo": "Coffre",
        "releaseType": "release"
      }
    ]
  }
}
